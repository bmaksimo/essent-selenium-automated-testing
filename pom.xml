    <!-- *** IMPORTANT: Use NOVA dependencies version numbers as properties.
            This is the new norm. *** -->
    <!-- *** Do NOT put any NOVA dependency version numbers directly in the
            maven dependencies section. *** -->
    <!-- *** Doing so will break the build and the release. *** -->
    <!-- *** Dependencies to other NOVA jars must also be placed in separate
            properties. *** -->
    <!-- *** This is necessary to allow hot fixing for these other libraries.
            *** -->
    <!-- ************************************************************************************************** -->

